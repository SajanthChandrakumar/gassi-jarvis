# Copy to ~/.config/jarvis/mac-agent.env and chmod 600.
# Values below are placeholders, not credentials.
JARVIS_CLOUD_API_BASE_URL=https://CHANGE_ME.ts.net
JARVIS_DEVICE_TOKEN=CHANGE_ME
JARVIS_DEVICE_ID=local-mac
JARVIS_DEVICE_AGENT_STATE_PATH=/Users/CHANGE_ME/Library/Application Support/Jarvis/device-agent.sqlite3
JARVIS_SHELL_CWD=/Users/CHANGE_ME/JarvisSandbox
JARVIS_AGENT_PROJECT_DIR=/Users/CHANGE_ME/Projects/gassi-jarvis
JARVIS_AGENT_PYTHON=/Users/CHANGE_ME/Projects/gassi-jarvis/venv/bin/python
